# ─────────────────────────────────────────────────────────────
# NeuralBridge — Environment Configuration
# Copy this file to .env and fill in your values. Every REPLACE_* and
# example.* value below is a placeholder: the code fails closed and honest
# when it is missing (see DEPLOY_NOW.md and deploy/assurance/README.md) —
# it never fakes a live charge or a live deployment. Swap the values in,
# do not add or rename keys unless the code that reads them changes too.
# ─────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════
# ASSURANCE PRODUCT — the thing customers pay for (src/assurance/,
# deployed with deploy/assurance/fly.toml + Dockerfile). See
# deploy/assurance/README.md for the full deploy walkthrough and
# DEPLOY_NOW.md for the founder's exact command sequence.
# ═══════════════════════════════════════════════════════════════

# ── Stripe (test keys in dev; live keys only on the real Fly deployment) ──
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Price IDs for the two self-serve plans. Unset, `GET /v1/plans` reports
# that plan as not purchasable and the site shows "Talk to sales" instead
# of "Buy" — it never fakes a buy button with nothing behind it. Supplier
# has no self-serve price (sales-assigned only, see ADR-0001) — route it
# through /contact instead of adding an ASSURANCE_PRICE_SUPPLIER var that
# nothing in src/assurance/billing/plans.py gates yet.
ASSURANCE_PRICE_REGISTER=price_REPLACE_REGISTER
ASSURANCE_PRICE_CELL=price_REPLACE_CELL

# ── Where the deployed API lives ───────────────────────────────
# The exact Fly hostname once deployed (deploy/assurance/fly.toml). Used to
# build correct checkout-redirect and webhook URLs — get this wrong and
# paying customers land on a dead page after checkout.
ASSURANCE_PUBLIC_URL=https://assurance.example.fly.dev
# The marketing site's own origin, for the pricing page's live plan fetch
# and CORS. Comma-separated; only override if the site is served from a
# different origin than these defaults (a Vercel preview URL, a staging
# domain).
ASSURANCE_ALLOWED_ORIGINS=https://neuralbridge.io,https://www.neuralbridge.io,http://localhost:3000
ASSURANCE_MARKETING_URL=https://neuralbridge.io

# ── API auth & ledger ───────────────────────────────────────────
# Comma-separated bootstrap API keys; generate with `openssl rand -hex 24`.
ASSURANCE_API_KEYS=
# 1 disables auth entirely — evaluation only, never on a public host.
# `GET /healthz` reports auth_mode: "open" when this is set; unset it
# before anyone else can reach the deployment.
ASSURANCE_ALLOW_UNAUTHENTICATED=
# Account/entitlement store and the Article 14 hash-chained ledger files.
# Defaults are fine for a single Fly volume; only override for a custom
# data directory layout.
ASSURANCE_ACCOUNTS=
ASSURANCE_LEDGER=
# Signed supplier advisory feeds this instance hosts, if any.
ASSURANCE_SUPPLIER_FEEDS=

# ── Counter-signed attestation (see deploy/assurance/ATTEST.md) ───
# A hash chain alone proves editing was caught, not deletion. Set these
# once you're ready to counter-sign the ledger head on a timer.
ASSURANCE_ATTEST_KEY=
ASSURANCE_ATTEST_KEY_PEM=
ASSURANCE_ATTEST_PASSPHRASE=
ASSURANCE_ATTEST_LOGS=

# ── Local uvicorn (uvicorn assurance.api.service:app) ──────────
ASSURANCE_HOST=0.0.0.0
ASSURANCE_PORT=8000
ASSURANCE_RELOAD=false

# ═══════════════════════════════════════════════════════════════
# MARKETING SITE (Next.js, app/) — set in Vercel → Project Settings
# → Environment Variables, not just here. Read at BUILD time and
# inlined into the client bundle, so a change needs a rebuild.
# ═══════════════════════════════════════════════════════════════

# Unset (the default until the API above is deployed), the site never
# fails or shows a broken component — every button that needs a live API
# degrades to an honest static/offline state ("Connect API URL" instead of
# a dead call). Empty is a valid, supported value, not a bug to work
# around. Set it to ASSURANCE_PUBLIC_URL above once that's deployed.
NEXT_PUBLIC_ASSURANCE_API_URL=

# ═══════════════════════════════════════════════════════════════
# NEURALBRIDGE PLATFORM LAYER (src/neuralbridge/) — the integration
# hub the assurance product is built on. Adapters here are evolving
# unless README.md marks them Supported; do not treat this section
# as a finished enterprise middleware config.
# ═══════════════════════════════════════════════════════════════

NEURALBRIDGE_ENV=development          # development | staging | production
NEURALBRIDGE_DEBUG=true
NEURALBRIDGE_HOST=0.0.0.0
NEURALBRIDGE_PORT=8000
NEURALBRIDGE_SECRET_KEY=change-me-to-a-random-64-char-string
NEURALBRIDGE_ENCRYPTION_KEY=          # Auto-generated on first run if empty

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neuralbridge:neuralbridge@localhost:5432/neuralbridge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── Authentication (src/neuralbridge/security/auth.py) ─────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── OpenTelemetry ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=neuralbridge

# ── Adapter credentials — only PostgreSQL and REST are Supported today;
#    everything else here is evolving (see README.md's platform table) ──
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

SAP_HOST=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AZURE_STORAGE_CONNECTION_STRING=

GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# ── CRA Compliance ────────────────────────────────────────────
CRA_ORGANIZATION_NAME=Your Organization
CRA_CONTACT_EMAIL=compliance@example.com
CRA_REPORTING_ENABLED=true

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_BURST=20

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
