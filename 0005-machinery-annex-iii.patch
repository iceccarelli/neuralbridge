+def seal_a_real_verification(ledger, *, when, speed=400.0, separation=2200.0):
+    env = SafetyEnvelope(
+        envelope_id="ENV-1", product="AR-7", product_version="2.4.1",
+        workspace=Workspace((-1200.0, -1200.0, 0.0), (1200.0, 1200.0, 2100.0)),
