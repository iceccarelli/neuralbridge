+        run_watch(config, ledger, now=T0 + timedelta(days=7))
+        assert len(manifests_from_ledger(ledger, "Grimaldi/AR-7#0412")) == before
+
+    def test_but_it_still_records_that_somebody_looked(self, work, config, ledger):
