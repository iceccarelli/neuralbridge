# The assurance register, as a deployable service.
#
# Deliberately not the NeuralBridge image: this package has no runtime
# dependencies of its own beyond a web server (and `cryptography`, for the
# Ed25519 attestation keys: `assurance.api.service` imports it at start-up, and
# an image without it does not boot), and shipping it alone keeps the attack
# surface of a regulatory register down to what it actually needs.
# tests/test_assurance_dockerfile_deps.py fails if a module the service loads
# imports a package the locked install does not provide, or if the install
# stops being hash-checked.
#
# Build from the repository root:  docker build -f deploy/assurance/Dockerfile .

FROM python:3.12-slim AS build

# Install from the hash-pinned lock, not from ranges. `--require-hashes` makes pip refuse any
# file whose SHA-256 is not in the lock; `--no-deps` stops it resolving anything the lock did
# not already pin. The lock is generated by scripts/lock.sh from requirements/assurance-service.txt
# for Python 3.12 (this base image). The build context is the repository root.
COPY requirements/assurance-service.lock /tmp/assurance-service.lock
RUN pip install --no-cache-dir --require-hashes --no-deps --prefix=/install \
      -r /tmp/assurance-service.lock

FROM python:3.12-slim

# Run as a non-root user. A service holding a regulatory record has no business
# running as root, and the container does not need to write anywhere except the
# mounted volume.
RUN useradd --create-home --uid 10001 assurance

COPY --from=build /install /usr/local
COPY --chown=assurance:assurance src/assurance /app/assurance

WORKDIR /app
USER assurance

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ASSURANCE_HOST=0.0.0.0 \
    ASSURANCE_PORT=8080 \
    ASSURANCE_LEDGER=/data/art14-register.db \
    ASSURANCE_ACCOUNTS=/data/accounts.db \
    ASSURANCE_TENANT_LEDGERS=/data/tenants \
    ASSURANCE_ATTEST_LOGS=/data/attestations \
    ASSURANCE_SUPPLIER_FEEDS=/data/supplier-feeds

EXPOSE 8080

# Container-level liveness only (the process answers); readiness is /healthz and is deliberately
# not what Docker restarts on. No curl in the slim image, so the standard library does the GET.
# Not exercised by a docker build in this repository's sandbox (no daemon); the same URL is what
# the CI assurance-image job requests with scripts/smoke_assurance_service.py.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/livez', timeout=4).status == 200 else 1)"]

# One worker, on purpose. The evidence ledger and the account store are SQLite
# on a single volume; a second process on a second machine would fork the
# evidence chain, which is the precise failure this package was written to
# prevent. Scale by making the machine bigger, or move the stores to Postgres
# first.
#
# What is and is not known about more than one worker ON ONE HOST (tests/test_multiworker_real.py
# starts real `--workers 4` processes over a shared volume): concurrent appends keep one valid
# hash chain, concurrent first writes to new tenant ledgers do not corrupt, the daily allowance is
# exact. Not covered: a network filesystem (SQLite locking is not reliable there), and the
# per-process limiters (the checkout/claim throttles and the Stripe call budget are in memory, so
# N workers admit N times the configured rate). That is why this stays 1 until someone decides
# otherwise; the test shows it is not blocked by chain safety.
#
# Proxy headers: uvicorn's `--proxy-headers` is ON by default, but it trusts
# `X-Forwarded-For` / `X-Forwarded-Proto` only from the addresses in
# `--forwarded-allow-ips`, which defaults to loopback (`127.0.0.1,::1`, or whatever `FORWARDED_ALLOW_IPS` says). This image does not
# widen that: it deliberately does NOT pass `--forwarded-allow-ips='*'`, which would make
# uvicorn trust the header from any peer that can reach the port, and the free-tier quota
# is keyed on the caller's address. Behind Fly's proxy the socket peer is Fly's proxy
# (not loopback), so forwarded headers are ignored and the application reads the
# proxy-set `Fly-Client-IP` itself, only when ASSURANCE_TRUST_FLY_PROXY=1 and only if it
# parses as an IP address (see deploy/assurance/README.md). Run on a host where a reverse
# proxy on the SAME machine forwards to this port, and uvicorn will trust that proxy's
# X-Forwarded-For.
CMD ["uvicorn", "assurance.api.service:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
